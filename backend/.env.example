ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

DATABASE_URL=postgresql+asyncpg://tagme3a:tagme3a@localhost:5432/tagme3a
REDIS_URL=redis://localhost:6379/0

MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=dev_master_key
MEILI_INDEX=products

# Firebase Admin SDK (service-account JSON path or inline JSON content)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=

SCRAPER_DELAY_SECONDS=1.0
SCRAPER_TIMEOUT_SECONDS=15.0
SCRAPER_MAX_RETRIES=2
STALE_AFTER_HOURS=24
SCRAPE_CRON_HOUR=2
SCRAPE_CRON_MINUTE=0
RECOMPUTE_CRON_MINUTE=30

# Scraper alerts: always logged; set a URL to also POST JSON to a webhook.
SCRAPER_ALERT_WEBHOOK_URL=
SCRAPER_ALERT_FAILURE_LIMIT=2
SCRAPER_ALERT_THROTTLE_LIMIT=3
SCRAPER_ALERT_DROP_RATIO=0.5

# Web Bot Auth for Compumarts. Both values are required to enable signing.
# The URL must serve the matching public JWK directory over HTTPS.
WEB_BOT_AUTH_AGENT_URL=
WEB_BOT_AUTH_PRIVATE_KEY=
WEB_BOT_AUTH_KEY_ID=
WEB_BOT_AUTH_EXPIRES_SECONDS=300

# M3 matcher thresholds (deterministic fuzzy/vector scoring)
MATCH_AUTO_MIN=0.88
MATCH_REVIEW_MIN=0.72
MATCH_VECTOR_DIMS=256

CORS_ORIGINS=["*"]
